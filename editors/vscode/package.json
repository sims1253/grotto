        "uiTheme": "vs-dark",
        "path": "./themes/restrained-night.json"
      },
      {
        "label": "Grotto Balanced Day",
        "uiTheme": "vs",
        "path": "./themes/balanced-day.json"
      },
      {
        "label": "Grotto Balanced Evening",
        "uiTheme": "vs-dark",
        "path": "./themes/balanced-evening.json"
      },
      {
        "label": "Grotto Balanced Night",
        "uiTheme": "vs-dark",
        "path": "./themes/balanced-night.json"
      },
      {
        "label": "Grotto Expressive Day",
        "uiTheme": "vs",
        "path": "./themes/expressive-day.json"
